# Raw, reduced, and generated datasets stay local.
/csv-data/
/export-data-set/
/export-data-set-r/
/survey-results/

# Generated evaluation trees stay local. Compact baseline evidence is kept
# under artifacts/baseline/ instead.
/result/
/saved_figures/
/artifacts/baseline/derived/*.mat

# Root-level generated plots, workbook copies, and training logs.
/*.fig
/*.png
/*.xlsx
/training_log*.csv

# Large generated calibration/training intermediates.
/net2_training_data.mat
/prepared_data_for_ptq.mat

# Editor/diagram backups and local archives.
*.asv
*.bkp
*.rar
*.zip

# Categorized local-only material and third-party code with unknown license.
/local-artifacts/
/.local/
/external/unlicensed/
